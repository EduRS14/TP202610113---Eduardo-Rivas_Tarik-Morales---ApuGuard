# =============================================
# APU GUARD - Variables de entorno
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env
#   cp .env.example backend/.env     (Django y los servicios leen este)
# NUNCA subas el .env real al repositorio ni a la imagen Docker
# (backend/.dockerignore lo excluye del build).
#
# REGLA: ningun valor de este fichero debe contener '$'.
#   Docker Compose interpeta $VAR / ${VAR} tambien dentro de los env_file,
#   asi que un secreto con '$' llega MUTILADO al contenedor (Fase A'):
#   50 caracteres en el .env llegaban como 41 al proceso. Si un valor
#   legitimo necesita '$', escapalo como $$.
# =============================================

# -- Django --
# OBLIGATORIO: sin el, el arranque falla con ImproperlyConfigured.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Sin '$' (ver regla arriba).
DJANGO_SECRET_KEY=CAMBIAR_POR_CLAVE_SECRETA_LARGA_Y_ALEATORIA
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Origenes permitidos para CORS y para cookies con CSRF.
# Produccion (CloudFront): https://dxxxxxxxxxxxx.cloudfront.net
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# -- Seguridad TLS --
# En DESARROLLO (HTTP) todo en False: con True Django entra en bucle de
# redireccion. En PRODUCCION con CloudFront se activan:
#   SECURE_SSL_REDIRECT=True
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
#   SECURE_HSTS_SECONDS=31536000
#   SECURE_PROXY_SSL_HEADER=True   (nginx traduce CloudFront-Forwarded-Proto)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=False

# -- Base de datos PostGIS --
# DB_PASSWORD tambien es OBLIGATORIO (sin valor por defecto).
# POSTGRES_PASSWORD debe ser EXACTAMENTE igual a DB_PASSWORD: la imagen
# postgis la usa en el primer arranque y docker-compose.yml la toma del
# mismo fichero (env_file del servicio db).
DB_NAME=apuguard_db
DB_USER=apuguard
DB_PASSWORD=CAMBIAR_PASSWORD_ALEATORIA_LARGA
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_ALEATORIA_LARGA
DB_HOST=db
DB_PORT=5432

# -- Celery / Redis --
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -- WSGI / gunicorn (Fase B) --
# PORT es el puerto de escucha del propio contenedor web (el mapeo de
# docker-compose esta en docker-compose.prod.yml).
PORT=8000
# 2 trabajadores x 4 hilos bastan: el procesamiento pesado vive en Celery,
# no en el proceso web. Subir WEB_CONCURRENCY solo multiplica RSS.
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=120

# -- AWS (usuario IAM con acceso a S3/SageMaker/SQS/SNS) --
# En PRODUCCION no se rellenan: el EC2 usa Instance Profile (IAM Role) y
# boto3 resuelve las credenciales sin fichero. Solo para desarrollo local.
AWS_ACCESS_KEY_ID=AKIA_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=CAMBIAR_SECRETO
AWS_REGION_NAME=us-east-1
AWS_S3_BUCKET=apuguard-datalake-prod
SAGEMAKER_ENDPOINT=apuguard-endpoint
SQS_RESULT_QUEUE_URL=https://sqs.<region>.amazonaws.com/<cuenta>/<cola>
SNS_ALERT_TOPIC_ARN=arn:aws:sns:<region>:<cuenta>:<tema>

# -- Adquisicion de imagenes --
#   stac: Earth Search (AWS). Defecto. Sin credenciales ni cuota.
#   gee : Google Earth Engine. Requiere earthengine-api + las variables GEE_*.
IMAGERY_SOURCE=stac
# Techo opcional de nubosidad (%) para descartar escenas STAC
#IMAGERY_MAX_CLOUD=60
# Rendimiento del composite (ver backend/ml_engine/acquisition.py)
#IMAGERY_WORKERS=16
#IMAGERY_MEM_MB=512
#IMAGERY_CHUNK_KB=1024
#IMAGERY_TMP_DIR=/tmp/apuguard

# -- Google Earth Engine (solo si IMAGERY_SOURCE=gee) --
#GEE_SERVICE_ACCOUNT=<cuenta-de-servicio>@<proyecto>.iam.gserviceaccount.com
#GEE_KEY_FILE=/app/gee_key.json

# -- Twilio SMS (se sigue usando) --
TWILIO_ACCOUNT_SID=AC_PLACEHOLDER
TWILIO_AUTH_TOKEN=CAMBIAR_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
